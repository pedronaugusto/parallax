{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig",
    "bench/baseline/diff/textdiff.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "shipped": {
    "docs": "Architecture linked by the packaged README for consumers of the library"
  },
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "parallax"
      ]
    },
    "zig build docs -- merge": {
      "source": "examples/usage.zig",
      "region": "merge",
      "imports": [
        "parallax"
      ]
    },
    "zig build docs -- refine": {
      "source": "examples/usage.zig",
      "region": "refine",
      "imports": [
        "parallax"
      ]
    },
    "zig build docs -- patch": {
      "source": "examples/usage.zig",
      "region": "patch",
      "imports": [
        "parallax"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-freestanding"
    ]
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "glint_paths": [
    "src",
    "bench",
    "examples",
    "ci",
    "build.zig"
  ],
  "glint": {
    "rules": [
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      }
    ],
    "strict_suppressions": true
  }
}
